  "components": [
    {
      "name": "Search Band",
      "kind": "custom",
      "refersTo": "search-band",
      "description": "The red-to-blue gradient sign band atop the National Dex: white title, count and the black search field.",
      "html": "<div class=\"ds-band\"><div class=\"ds-band-row\"><span class=\"ds-band-title\">National Dex</span><span class=\"ds-band-count\">1,025 Pokémon</span></div><label class=\"ds-field\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z\"/></svg><input class=\"ds-input\" placeholder=\"Name, number or type\"></label></div>",
      "css": ".ds-band{background:linear-gradient(90deg,#C8102E,#1D4ED8);color:#FFFFFF;padding:8px 16px 16px;display:flex;flex-direction:column;gap:8px;font-family:'Atkinson Hyperlegible Next',system-ui,sans-serif;} .ds-band-row{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 8px} .ds-band-title{font-weight:800;font-size:28px;line-height:34px;letter-spacing:-0.3px} .ds-band-count{font-weight:500;font-size:15px;line-height:20px;font-variant-numeric:tabular-nums} .ds-field{display:flex;align-items:center;gap:8px;min-height:52px;padding-left:16px;background:#0B0B0B;color:#FFFFFF} .ds-input{flex:1;background:transparent;border:0;outline:none;color:#FFFFFF;caret-color:#FF7A85;font:500 17px/24px inherit;font-family:inherit;padding:8px 0} .ds-input::placeholder{color:#A3A3A3} .ds-field:focus-within{box-shadow:inset 0 0 0 2px #FF7A85}"
    },
    {
      "name": "Generation Gate Sign",
      "kind": "custom",
      "refersTo": "gate-sign",
      "description": "Sticky black panel sign heading each generation in the Dex; the range gives way first.",
      "html": "<div class=\"ds-gate\"><span class=\"ds-gate-gen\">Gen I</span><span class=\"ds-gate-region\">Kanto</span><span class=\"ds-gate-range\">0001–0151</span></div>",
      "css": ".ds-gate{display:flex;align-items:center;gap:16px;height:44px;padding:0 16px;background:#0B0B0B;font-family:'Atkinson Hyperlegible Next',system-ui,sans-serif;} .ds-gate-gen{color:#FF7A85;font-weight:800;font-size:17px;line-height:22px;white-space:nowrap} .ds-gate-region{color:#FFFFFF;font-weight:700;font-size:17px;line-height:22px;white-space:nowrap;flex-shrink:0} .ds-gate-range{flex:1;min-width:0;text-align:right;color:#A3A3A3;font-weight:500;font-size:14px;line-height:20px;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
    },
    {
      "name": "Section Sign",
      "kind": "custom",
      "refersTo": "section-sign",
      "description": "Sticky panel sign heading each section of a Pokémon page; the detail wraps at large text.",
      "html": "<div class=\"ds-section\"><span class=\"ds-section-title\">Base stats</span><span class=\"ds-section-detail\">Total 320</span></div>",
      "css": ".ds-section{display:flex;flex-wrap:wrap;align-items:center;column-gap:16px;min-height:44px;padding:8px 16px;box-sizing:border-box;background:#0B0B0B;font-family:'Atkinson Hyperlegible Next',system-ui,sans-serif;} .ds-section-title{color:#FF7A85;font-weight:800;font-size:17px;line-height:22px} .ds-section-detail{flex-grow:1;text-align:right;color:#A3A3A3;font-weight:500;font-size:14px;line-height:20px;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Dex Row",
      "kind": "card",
      "refersTo": "dex-row",
      "description": "One Pokémon in the National Dex: big number, sprite, name over named type badges.",
      "html": "<button class=\"ds-row\"><span class=\"ds-row-num\">0025</span><span class=\"ds-row-sprite\"></span><span class=\"ds-row-body\"><span class=\"ds-row-name\">Pikachu</span><span class=\"ds-badge\" style=\"background:#FFD23F;color:#0B0B0B\">Electric</span></span></button>",
      "css": ".ds-row{display:flex;align-items:center;gap:8px;width:100%;height:72px;padding:0 16px;background:#FFFFFF;color:#0B0B0B;border:0;border-bottom:2px solid #A8A8A8;text-align:left;cursor:pointer;font-family:'Atkinson Hyperlegible Next',system-ui,sans-serif;} .ds-row:hover{background:#F0F0F0} .ds-row:active{background:#E6E6E6} .ds-row:focus-visible{outline:2px solid #0B0B0B;outline-offset:-2px} .ds-row-num{min-width:72px;font-weight:800;font-size:26px;line-height:32px;letter-spacing:-0.5px;font-variant-numeric:tabular-nums} .ds-row-sprite{width:56px;height:56px} .ds-row-body{display:flex;flex-direction:column;align-items:flex-start;gap:4px;flex:1} .ds-row-name{font-weight:700;font-size:18px;line-height:24px} .ds-badge{border-radius:4px;padding:2px 8px;font-weight:700;font-size:12px;line-height:16px;letter-spacing:0.3px}"
    },
    {
      "name": "Type Badges",
      "kind": "chip",
      "refersTo": "type-badge",
      "description": "A type always named on its AA-checked fill; on the gradient band it gets a 1dp white outline.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-tb\" style=\"background:#C2410C;color:#FFFFFF\">Fire</span><span class=\"ds-tb\" style=\"background:#1D63C7;color:#FFFFFF\">Water ×2</span><span class=\"ds-tb\" style=\"background:#7FD3DD;color:#0B0B0B\">Ice ×½</span><span class=\"ds-onband\"><span class=\"ds-tb ds-tb-band\" style=\"background:#FFD23F;color:#0B0B0B\">Electric</span></span></div>",
      "css": ".ds-badges{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-family:'Atkinson Hyperlegible Next',system-ui,sans-serif;} .ds-tb{display:inline-block;border-radius:4px;padding:2px 8px;font-weight:700;font-size:12px;line-height:16px;letter-spacing:0.3px} .ds-onband{background:linear-gradient(90deg,#C8102E,#1D4ED8);padding:8px} .ds-tb-band{border:1px solid #FFFFFF}"
    },
    {
      "name": "Form Chips",
      "kind": "chip",
      "refersTo": "form-chip",
      "description": "Form picker on the identity band: 2dp white outline, selected fills sign black.",
      "html": "<div class=\"ds-forms\"><button class=\"ds-fchip ds-fchip-on\">Pikachu</button><button class=\"ds-fchip\">Gigantamax Pikachu</button></div>",
      "css": ".ds-forms{display:flex;gap:8px;background:linear-gradient(90deg,#C8102E,#1D4ED8);padding:16px;font-family:'Atkinson Hyperlegible Next',system-ui,sans-serif;} .ds-fchip{min-height:40px;padding:0 16px;border:2px solid #FFFFFF;border-radius:8px;background:transparent;color:#FFFFFF;font-weight:700;font-size:14px;line-height:18px;font-family:inherit;cursor:pointer} .ds-fchip:hover{background:rgba(255,255,255,0.12)} .ds-fchip:active{opacity:0.6} .ds-fchip:focus-visible{outline:2px solid #FFFFFF;outline-offset:2px} .ds-fchip-on,.ds-fchip-on:hover{background:#0B0B0B;border-color:#0B0B0B;color:#FFFFFF}"
    },
    {
