      "css": ".ds-games{display:flex;gap:8px;padding:16px;background:#FFFFFF;font-family:'Atkinson Hyperlegible Next',system-ui,sans-serif;} .ds-gchip{min-height:40px;padding:0 16px;border:2px solid #5C5C5C;border-radius:8px;background:transparent;color:#0B0B0B;font-weight:700;font-size:14px;line-height:18px;font-family:inherit;cursor:pointer} .ds-gchip:hover{background:#F0F0F0} .ds-gchip:focus-visible{outline:2px solid #0B0B0B;outline-offset:2px} .ds-gchip-on,.ds-gchip-on:hover{background:#C8102E;border-color:#C8102E;color:#FFFFFF}"
